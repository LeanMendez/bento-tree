{
  "name": "bento-tree",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "deploy": "astro build && wrangler deploy",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build",
    "spotify:auth": "node --env-file-if-exists=.dev.vars scripts/spotify-auth.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "astro": "^7.4.7",
    "wrangler": "^4.158.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
