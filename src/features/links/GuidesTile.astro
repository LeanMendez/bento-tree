---
import IconBox from '../../components/ui/IconBox.astro';
import Pill from '../../components/ui/Pill.astro';
import Tag from '../../components/ui/Tag.astro';
import Tile from '../../components/ui/Tile.astro';
import TileHead from '../../components/ui/TileHead.astro';
import TileTitle from '../../components/ui/TileTitle.astro';
import { site } from '../../config/site';
import type { Strings } from '../../i18n';

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const { guides } = site;
---

<Tile href={guides.url} newTabLabel={t.newTab} color="yellow" span={2} category="code">
  <TileHead>
    <IconBox icon="book" />
    <Pill variant="count">{t.guidesCount(guides.count)}</Pill>
  </TileHead>
  <div class="body">
    <TileTitle size={30}>{t.guides}</TileTitle>
    <div class="tags">
      {guides.topics.map((topic) => (
        <Tag size="md">{topic}</Tag>
      ))}
    </div>
  </div>
</Tile>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>
