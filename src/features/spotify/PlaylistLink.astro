---
import type { Lang } from '../../i18n';
import PlaylistContent from './PlaylistContent.astro';
import PlaylistPill from './PlaylistPill.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<PlaylistContent server:defer lang={lang}>
  <PlaylistPill slot="fallback" lang={lang} />
</PlaylistContent>
