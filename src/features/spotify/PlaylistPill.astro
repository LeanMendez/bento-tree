---
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../config/site';
import { getStrings, type Lang } from '../../i18n';
import type { PlaylistData } from './spotify.service';

interface Props {
  lang: Lang;
  /** Playlist actual; sin dato se usa el texto y la playlist default del diseño. */
  playlist?: PlaylistData | null;
}
const { lang, playlist } = Astro.props;
const t = getStrings(lang);
---

<a
  class="playlist"
  href={playlist?.url ?? site.spotify.defaultPlaylistUrl}
  title={playlist?.name}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon name="headphones" size={18} />
  <span class="name">{playlist?.name ?? t.playlist}</span>
  <span class="sr-only"> ({t.newTab})</span>
</a>

<style>
  .playlist {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--hit-min);
    max-width: 100%;
    padding: 0 14px;
    background: var(--c-green);
    color: var(--c-ink);
    border: var(--border-control) solid var(--c-ink);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }
  .name {
    /* Nombres largos de playlist: truncar (PLAN.md §5.3). */
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .playlist :global(svg) {
    flex: none;
  }
</style>
