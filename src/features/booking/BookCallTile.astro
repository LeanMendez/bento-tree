---
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Tile from '../../components/ui/Tile.astro';
import { site } from '../../config/site';
import type { Strings } from '../../i18n';

interface Props {
  t: Strings;
}
const { t } = Astro.props;
---

<Tile as="section" color="ink" span={2}>
  <div>
    <h2 class="title">{t.ctaTitle}</h2>
    <p class="sub hide-sm">{t.ctaSub}</p>
  </div>
  <div class="row">
    <Button variant="cta" href={site.calendlyUrl} target="_blank" rel="noopener noreferrer" data-calendly>
      <Icon name="calendar" size={20} strokeWidth={2.4} color="var(--cta-btn-fg)" />
      {t.ctaBtn}
    </Button>
  </div>
</Tile>

<script>
  import { bindCalendly } from './calendly';

  bindCalendly();
</script>

<style>
  .title {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--cta-fg);
  }
  .sub {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--cta-fg);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px 16px;
    flex-wrap: wrap;
  }
  @media (max-width: 560px) {
    .title {
      font-size: 22px;
    }
  }
</style>
