---
import SegmentedControl from '../../components/ui/SegmentedControl.astro';
import { LANGS, homePath, type Lang, type Strings } from '../../i18n';
import { LANG_STORAGE_KEY } from './locale';

interface Props {
  lang: Lang;
  t: Strings;
}
const { lang, t } = Astro.props;

const NAMES: Record<Lang, string> = { es: 'Español', en: 'English' };
const items = LANGS.map((code) => ({
  label: code.toUpperCase(),
  ariaLabel: NAMES[code],
  pressed: code === lang,
  href: homePath(code),
  attrs: { 'data-lang': code, hreflang: code },
}));
---

<SegmentedControl variant="lang" ariaLabel={t.langLabel} items={items} />

<!-- Inline: el listener existe apenas se parsea el selector, antes de que el usuario pueda clickear
     (con un módulo diferido, un click temprano no guardaba la elección). -->
<script is:inline define:vars={{ langKey: LANG_STORAGE_KEY }}>
  for (const link of document.querySelectorAll('[data-lang]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(langKey, link.dataset.lang ?? '');
      } catch {
        // Sin storage: la elección vale solo para esta navegación.
      }
    });
  }
</script>
