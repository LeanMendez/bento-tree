---
import IconBox from '../../components/ui/IconBox.astro';
import Tile from '../../components/ui/Tile.astro';
import TileHead from '../../components/ui/TileHead.astro';
import { site } from '../../config/site';
import { getStrings, LANGS, type Strings } from '../../i18n';
import FeaturedRepoContent from './FeaturedRepoContent.astro';
import RepoContent from './RepoContent.astro';

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const lang = LANGS.find((l) => getStrings(l) === t) ?? 'es';
const { featured, profileLabel } = site.github;
---

<Tile href={featured.url} color="green" span={2} mobileSingle category="code">
  <TileHead gap={12}>
    <IconBox icon="code" />
    <span class="kicker hide-sm">{t.featuredRepo}</span>
  </TileHead>
  <FeaturedRepoContent server:defer lang={lang}>
    <RepoContent
      slot="fallback"
      name={featured.name}
      description={t.repoDesc}
      tags={featured.tags}
      owner={profileLabel}
    />
  </FeaturedRepoContent>
</Tile>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
