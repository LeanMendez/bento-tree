---
import IconBox from '../../components/ui/IconBox.astro';
import Tag from '../../components/ui/Tag.astro';
import Tile from '../../components/ui/Tile.astro';
import TileHead from '../../components/ui/TileHead.astro';
import TileTitle from '../../components/ui/TileTitle.astro';
import { site } from '../../config/site';
import type { Strings } from '../../i18n';

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const { featured, profileLabel } = site.github;
---

<Tile href={featured.url} color="green" span={2} mobileSingle category="code">
  <TileHead gap={12}>
    <IconBox icon="code" />
    <span class="kicker hide-sm">{t.featuredRepo}</span>
  </TileHead>
  <div>
    <TileTitle size={28}>{featured.name}</TileTitle>
    <div class="desc hide-sm">{t.repoDesc}</div>
    <div class="meta hide-sm">
      {featured.tags.map((tag) => (
        <Tag>{tag}</Tag>
      ))}
      <span class="owner">{profileLabel}</span>
    </div>
  </div>
</Tile>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .desc {
    font-size: 15px;
    margin-top: 6px;
  }
  .meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .owner {
    padding: 4px 0;
  }
</style>
