---
interface Props {
  size: 26 | 28 | 30;
}
const { size } = Astro.props;
---

<div class:list={['ttl', `t${size}`]}>
  <slot />
</div>

<style>
  .ttl {
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .t26 {
    font-size: 26px;
  }
  .t28 {
    font-size: 28px;
    line-height: 1;
  }
  .t30 {
    font-size: 30px;
    line-height: 1;
  }
  @media (max-width: 560px) {
    .ttl {
      font-size: 20px;
    }
  }
</style>
