# Copiar a `.env` (build/dev) y completar. Nunca commitear `.env` ni `.dev.vars`.

# --- Perfil y links (públicos en la página, fuera del repo) ---
PUBLIC_OWNER_NAME="Jane Doe"
PUBLIC_OWNER_INITIALS="JD"
PUBLIC_OWNER_ROLE="Product Builder + Engineering Manager"
PUBLIC_OWNER_EMAIL="jane@example.com"
PUBLIC_GITHUB_USER="janedoe"
PUBLIC_GITHUB_FEATURED_REPO="my-project"
PUBLIC_TWITCH_LOGIN="janedoe"
PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/janedoe/"
PUBLIC_X_URL="https://x.com/janedoe"
PUBLIC_PORTFOLIO_URL="https://example.com/"
PUBLIC_BLOG_URL="https://example.com/posts/"
PUBLIC_BLOG_RSS_URL="https://example.com/rss.xml"
# Opcional: sin valor, la tile de guías se muestra sin link.
PUBLIC_GUIDES_URL=
PUBLIC_CALENDLY_URL="https://calendly.com/janedoe/30min"
PUBLIC_SPOTIFY_DEFAULT_PLAYLIST_URL="https://open.spotify.com/playlist/xxxxxxxxxxxxxxxxxxxxxx"

# --- Secrets de runtime (en dev: `.dev.vars`; en prod: `wrangler secret put`) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GITHUB_TOKEN=
